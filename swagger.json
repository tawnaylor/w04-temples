{
  "swagger": "2.0",
  "info": {
    "title": "Temple API",
    "description": "LDS Temple API for CSE 341 (Swagger documentation activity)",
    "version": "1.0.0"
  },
  "host": "localhost:8080",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "apiKey": {
      "type": "apiKey",
      "in": "header",
      "name": "apiKey",
      "description": "API key required by the temple read routes"
    }
  },
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/temples/": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "apiKey",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "post": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/temples/{temple_id}": {
      "get": {
        "description": "",
        "parameters": [
          {
            "name": "temple_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "apiKey",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "temple_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "temple_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    }
  },
  "definitions": {
    "Temple": {
      "type": "object",
      "properties": {
        "temple_id": {
          "type": "number",
          "example": 1
        },
        "name": {
          "type": "string",
          "example": "Aba Nigeria Temple"
        },
        "location": {
          "type": "string",
          "example": "Aba, Abia, Nigeria"
        },
        "dedicated": {
          "type": "string",
          "example": "7 August 2005"
        },
        "additionalInfo": {
          "type": "boolean",
          "example": false
        }
      }
    }
  }
}